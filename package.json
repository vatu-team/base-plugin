{
    "name": "base-plugin",
    "version": "1.0.0",
    "description": "NPM configuration for Base Plugin development.",
    "author": "Vatu <info@vatu.dev>",
    "license": "MIT",
    "engines": {
        "npm": ">=11.8 <12.0.0",
        "node": ">=24.13 <25.0.0"
    },
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1",
        "build": "run-s 'build:plugin'",
        "watch": "run-p 'watch:plugin'",
        "build:plugin": "run-s 'build:plugin:resources' 'build:plugin:core:**'",
        "watch:plugin": "run-p 'watch:plugin:resources' 'watch:plugin:core:**'",
        "build:plugin:resources": "wp-scripts build --config ./plugin.webpack.config.js",
        "watch:plugin:resources": "wp-scripts start --config ./plugin.webpack.config.js",
        "build:plugin:core:example": "wp-scripts build --webpack-src-dir=./src/Domain/Example/Blocks/ --output-path=./build/blocks/example",
        "watch:plugin:core:example": "wp-scripts start --webpack-src-dir=./src/Domain/Example/Blocks/ --output-path=./build/blocks/example",
        "format": "wp-scripts format",
        "lint:css": "wp-scripts lint-style",
        "lint:js": "wp-scripts lint-js",
        "wp-env": "wp-env",
        "composer": "wp-env run composer"
    },
    "devDependencies": {
        "@wordpress/components": "^33.0.0",
        "@wordpress/compose": "^8.0.0",
        "@wordpress/core-data": "^7.48.0",
        "@wordpress/create-block": "^4.88.0",
        "@wordpress/i18n": "^6.16.0",
        "@wordpress/icons": "^14.0.0",
        "@wordpress/env": "^11.5.0",
        "@wordpress/plugins": "^7.46.0",
        "@wordpress/scripts": "^32.3.0",
        "glob": "^13.0.6",
        "npm-run-all": "^4.1.5",
        "path": "^0.12.7",
        "rtlcss-webpack-plugin": "^4.0.7",
        "svg-spritemap-webpack-plugin": "^5.1.3",
        "webpack-remove-empty-scripts": "^1.1.1"
    }
}
